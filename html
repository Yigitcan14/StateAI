<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StateAI</title>
    <style>
        /* Genel Sıfırlama ve Tasarım */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            display: flex;
            height: 100vh;
            background-color: #212121;
            color: #ececec;
        }

        /* Sol Menü (Sidebar) */
        .sidebar {
            width: 260px;
            background-color: #171717;
            display: flex;
            flex-direction: column;
            padding: 10px;
            border-right: 1px solid #2f2f2f;
        }

        .new-chat-btn {
            background-color: transparent;
            border: 1px solid #424242;
            color: white;
            padding: 10px;
            border-radius: 6px;
            cursor: pointer;
            text-align: left;
            margin-bottom: 20px;
            font-size: 14px;
            transition: background 0.2s;
        }

        .new-chat-btn:hover {
            background-color: #2f2f2f;
        }

        .chat-list {
            list-style: none;
            overflow-y: auto;
        }

        .chat-list li {
            padding: 10px;
            font-size: 14px;
            border-radius: 6px;
            cursor: pointer;
            color: #b4b4b4;
            margin-bottom: 4px;
        }

        .chat-list li:hover {
            background-color: #2a2a2a;
            color: white;
        }

        /* Ana İçerik Alanı */
        .main-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100vh;
        }

        /* Sohbet Akışı */
        .chat-history {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-width: 800px;
            width: 100%;
            margin: 0 auto;
        }

        .message {
            display: flex;
            gap: 15px;
            font-size: 15px;
            line-height: 1.5;
        }

        .message.user {
            justify-content: flex-end;
        }

        .message .bubble {
            padding: 12px 16px;
            border-radius: 12px;
            max-width: 70%;
        }

        .message.user .bubble {
            background-color: #2f2f2f;
            color: white;
        }

        .message.ai .bubble {
            background-color: transparent;
            color: #ececec;
        }

        /* Mesaj Giriş Alanı */
        .input-container {
            padding: 20px;
            max-width: 800px;
            width: 100%;
            margin: 0 auto;
            position: relative;
        }

        .input-box {
            display: flex;
            background-color: #2f2f2f;
            border-radius: 12px;
            padding: 10px 15px;
            border: 1px solid #424242;
        }

        .input-box textarea {
            flex: 1;
            background: transparent;
            border: none;
            color: white;
            font-size: 15px;
            resize: none;
            outline: none;
            height: 24px;
            max-height: 200px;
        }

        .input-box button {
            background-color: #ececec;
            color: #212121;
            border: none;
            border-radius: 6px;
            width: 32px;
            height: 32px;
            cursor: pointer;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .input-box button:hover {
            background-color: #ffffff;
        }
    </style>
</head>
<body>

    <!-- Sol Menü -->
    <div class="sidebar">
        <button class="new-chat-btn">+ Yeni Sohbet</button>
        <ul class="chat-list">
            <li>StateAI Başlangıç</li>
            <li>Python API Bağlantısı</li>
        </ul>
    </div>

    <!-- Ana Sohbet Ekranı -->
    <div class="main-container">
        <div class="chat-history">
            <!-- Kullanıcı Mesajı -->
            <div class="message user">
                <div class="bubble">Selam StateAI, sistem aktif mi?</div>
            </div>
            <!-- Yapay Zeka Mesajı -->
            <div class="message ai">
                <div class="bubble">Merhaba! StateAI arayüzü başarıyla yüklendi. Bulut bağlantısını bekliyorum.</div>
            </div>
        </div>

        <!-- Girdi Alanı -->
        <div class="input-container">
            <div class="input-box">
                <textarea placeholder="StateAI'a bir şeyler yazın..."></textarea>
                <button>&#8593;</button>
            </div>
        </div>
    </div>

</body>
</html>
